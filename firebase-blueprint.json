{
  "entities": {
    "User": {
      "title": "User",
      "description": "User account profile for synchronization",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique Firebase user ID"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "maxLength": 100,
          "description": "User display name"
        },
        "photoURL": {
          "type": "string",
          "description": "User avatar photo URL"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Account registration timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Account last update timestamp"
        }
      },
      "required": ["uid", "email"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "A single financial income or expense ledger record",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique transaction document identifier"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "description": "Owner user identifier"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Concise transaction memo or label"
        },
        "amount": {
          "type": "number",
          "description": "Monetary value strictly greater than zero"
        },
        "type": {
          "type": "string",
          "enum": ["income", "expense"],
          "description": "Ledger movement type"
        },
        "category": {
          "type": "string",
          "enum": [
            "Salary",
            "Freelance",
            "Investments",
            "Business",
            "Rental",
            "Housing",
            "Groceries",
            "Transport",
            "Utilities",
            "Entertainment",
            "Healthcare",
            "Education",
            "Shopping",
            "Dining Out",
            "Personal Care",
            "Travel",
            "Others"
          ],
          "description": "Assigned financial category"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Transaction calendar date formatted as YYYY-MM-DD"
        },
        "createdAt": {
          "type": "string",
          "description": "Record creation timestamp ISO string or number string"
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["UPI", "Cash", "Debit Card", "Credit Card", "Bank Transfer", "Other"],
          "description": "Payment instrument used"
        },
        "recurring": {
          "type": "boolean",
          "description": "Whether the transaction repeats periodically"
        },
        "recurringFrequency": {
          "type": "string",
          "enum": ["weekly", "monthly", "yearly"],
          "description": "Frequency of recurring transaction"
        },
        "receipt": {
          "type": "string",
          "description": "Receipt reference or attachment info"
        },
        "notes": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional memo or notes"
        }
      },
      "required": [
        "id",
        "userId",
        "description",
        "amount",
        "type",
        "category",
        "date"
      ]
    },
    "ConnectionProbe": {
      "title": "ConnectionProbe",
      "description": "Health probe document used by client boot test",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "description": "Probe status"
        }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Private profile document for each user"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Secure subcollection storing the user's private financial records"
    },
    "/test/{docId}": {
      "schema": "ConnectionProbe",
      "description": "Public health check probe for connection testing"
    }
  }
}
